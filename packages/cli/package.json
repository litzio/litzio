{
  "name": "@litzio/cli",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "package": "pnpm build && npm pack ./dist --pack-destination ./dist --ignore-scripts",
    "test:packaged": "tsx --test test/packaged.test.ts",
    "test": "tsx --test test/cli.test.ts test/daemon.test.ts test/notices.test.ts test/remote-host.test.ts test/app-reset.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@litzio/core": "workspace:*",
    "@litzio/file-commit": "workspace:*",
    "@litzio/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "esbuild": "0.28.2",
    "@types/node": "^24.5.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}

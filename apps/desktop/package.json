{
  "name": "@litzio/desktop",
  "version": "0.0.2-beta.4",
  "private": true,
  "license": "MIT",
  "description": "Desktop editor and local file Host",
  "author": "Litzio contributors",
  "type": "module",
  "scripts": {
    "icons": "tsx scripts/generate-icon.ts",
    "build": "tsx scripts/build.ts",
    "start": "electron build/app",
    "package": "tsx scripts/package.ts",
    "test": "tsx ../../packages/cli/scripts/build-docling-worker.ts && tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:packaged": "tsx --test --test-concurrency=1 test/packaged/packaged.e2e.ts test/packaged/cli.e2e.ts",
    "test:update": "tsx --test test/packaged/update.e2e.ts",
    "test:uninstall": "tsx --test test/packaged/uninstall.e2e.ts",
    "test:update:github": "tsx test/packaged/update.e2e.ts --github"
  },
  "devDependencies": {
    "@litzio/plugin-api": "workspace:*",
    "@litzio/file-commit": "workspace:*",
    "@playwright/test": "1.64.0-alpha-1789764292000",
    "@types/node": "^24.5.2",
    "@types/semver": "^7.7.1",
    "builder-util-runtime": "9.7.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-updater": "6.8.9",
    "esbuild": "0.28.2",
    "js-yaml": "5.4.2",
    "semver": "7.7.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}

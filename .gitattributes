# Keep pnpm patches stable; unified-diff blank context lines need their space prefix.
patches/*.patch text eol=lf -whitespace

# Samples must already match Core canonical LF output on every checkout.
apps/editor/samples/** text eol=lf

# Preserve reference bytes and SHA-256 sums across checkouts.
community-plugins/docling/sample/lsr-1.1/** -text

# Retain verbatim upstream font notice whitespace.
community-plugins/docling/sample/lsr-1.1/resources/fonts/DejaVu-LICENSE.txt -whitespace
community-plugins/docling/sample/nist-sp1108r4/** -text

# Preserve vendored upstream schema/license bytes and documented schema SHA.
community-plugins/docling/schema/DoclingDocument-1.10.0.json -text
community-plugins/docling/schema/LICENSE -text

# Product assistant instructions retain the original template-string LF bytes.
apps/editor/server/assistant/AGENTS.md text eol=lf
apps/editor/server/assistant/litzio-guide/SKILL.md text eol=lf

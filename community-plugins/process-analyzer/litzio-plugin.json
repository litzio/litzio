              "minLength": 5,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,126}\\.csv$"
            },
            "dateTo": {
              "type": "string",
              "title": "종료일",
              "description": "목록에서 고르는 날짜(YYYY-MM-DD). 시작일·종료일을 모두 비우면 전체 기간이에요.",
              "maxLength": 10

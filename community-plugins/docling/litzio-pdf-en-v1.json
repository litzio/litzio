    "note": "Request values copied verbatim. Full PDF uses the official API default page_range instead of parsing page count locally."
  },
  "request": {
    "target_type": "inbody",
    "from_formats": [
      "pdf"
    ],
    "to_formats": [
      "json"
    ],
    "image_export_mode": "embedded",
    "pipeline": "standard",
    "pdf_backend": "threaded_docling_parse",
    "do_ocr": true,
    "force_ocr": false,
    "ocr_preset": "rapidocr",
    "ocr_lang": [
      "en"
    ],
    "do_table_structure": true,
    "table_structure_preset": "tableformer_v1_accurate",
    "table_mode": "accurate",
    "table_cell_matching": true,
    "layout_preset": "default",
    "do_pdf_heading_hierarchy": true,
    "pdf_heading_hierarchy_options": {
      "use_bookmarks": true,
      "use_numbering": true,
      "use_style": true,
      "use_font_style": true,
      "style_size_tolerance": 0.05,
      "max_level": 6,
      "bookmark_match_threshold": 0.8
    },
    "include_images": true,
    "include_page_images": true,
    "images_scale": 2.0,
    "do_code_enrichment": true,
    "do_formula_enrichment": true,
    "code_formula_preset": "codeformulav2",
    "do_picture_classification": true,
    "picture_classification_preset": "document_figure_classifier_v2",
    "do_chart_extraction": false,
    "do_picture_description": false,
    "abort_on_error": false
  }

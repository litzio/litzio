{
  "schemaVersion": 1,
  "id": "community.docling",
  "tier": "community",
  "publisher": {
    "id": "community",
    "name": "Community"
  },
  "name": "Docling",
  "description": "docling-serve 연결 확인, PDF 원본 보관과 Litzio 문서 만들기",
  "version": "0.0.2",
  "requiresSdk": ">=0.3.0 <1.0.0",
  "entry": "host.js",
  "contributes": {
    "operations": [
      {
        "id": "connection",
        "version": 1,
        "effect": "read",
        "scope": "host",
        "assistant": true,
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "required": [
            "ok",
            "message"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "start",
        "version": 1,
        "effect": "write",
        "scope": "host",
        "assistant": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "root": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "resultFile": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "maxBytes": {
                  "type": "number"
                }
              },
              "required": [
                "path",
                "maxBytes"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "requestId",
            "root",
            "file",
            "output"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "running",
                "completed",
                "failed",
                "stopped",
                "uncertain"
              ]
            },
            "phase": {
              "type": "string"
            },
            "errorKind": {
              "type": "string"
            },
            "document": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "file": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "state",
            "phase"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "job-status",
        "version": 1,
        "effect": "read",
        "scope": "host",
        "assistant": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "root": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "resultFile": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "maxBytes": {
                  "type": "number"
                }
              },
              "required": [
                "path",
                "maxBytes"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "requestId",
            "root",
            "file",
            "output"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "running",
                "completed",
                "failed",
                "stopped",
                "uncertain"
              ]
            },
            "phase": {
              "type": "string"
            },
            "errorKind": {
              "type": "string"
            },
            "document": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "file": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "state",
            "phase"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "job-stop",
        "version": 1,
        "effect": "write",
        "scope": "host",
        "assistant": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "root": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "resultFile": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "maxBytes": {
                  "type": "number"
                }
              },
              "required": [
                "path",
                "maxBytes"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "requestId",
            "root",
            "file",
            "output"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "running",
                "completed",
                "failed",
                "stopped",
                "uncertain"
              ]
            },
            "phase": {
              "type": "string"
            },
            "errorKind": {
              "type": "string"
            },
            "document": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "file": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "state",
            "phase"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "convert-pdf",
        "version": 1,
        "effect": "write",
        "scope": "host",
        "assistant": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "root": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "output": {
              "type": "string"
            },
            "resultFile": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "maxBytes": {
                  "type": "number"
                }
              },
              "required": [
                "path",

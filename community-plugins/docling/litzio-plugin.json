                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            },
            "file": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "state",
            "phase"
          ],
          "additionalProperties": false
        }
      }
    ],
    "screens": [
      {
        "id": "connection",
        "title": "Docling",
        "icon": "Table",
        "primary": true,
        "jobs": [
          "convert-pdf",
          "create-document"
        ]
      }
    ],
    "jobs": [
      {
        "id": "convert-pdf",
        "title": "PDF 변환",
        "accept": [
          ".pdf"
        ],
        "start": "convert-pdf",
        "status": "job-status",
        "stop": "job-stop",
        "resultKind": "file",
        "resultExtension": ".docling"
      },
      {
        "id": "create-document",
        "title": "Litzio 문서 만들기",
        "accept": [
          ".docling"
        ],
        "start": "start",
        "status": "job-status",
        "stop": "job-stop",
        "resultKind": "native-document"
      }
    ],
    "healthCheck": "connection"
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "serverUrl": {
        "type": "string",
        "title": "docling-serve URL",
        "description": "HTTP(S) 서버 기본 주소. API 키가 없는 서버만 지원합니다.",
        "default": "http://127.0.0.1:5001",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "icon": "icon.svg"
}

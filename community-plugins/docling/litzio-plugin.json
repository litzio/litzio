{
  "schemaVersion": 1,
  "id": "community.docling",
  "tier": "community",
  "publisher": {
    "id": "community",
    "name": "Community"
  },
  "name": "Docling",
  "description": "docling-serve 연결 확인과 .docling에서 Litzio 문서 만들기",
  "version": "0.1.0",
  "requiresSdk": "0.1.0",
  "entry": "host.js",
  "contributes": {
    "operations": [
      {
        "id": "connection",
        "version": 1,
        "effect": "read",
        "scope": "host",
        "assistant": true,
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "server": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "server",
              "status",
              "detail"
            ],
            "additionalProperties": false
          }
        },
        "rowSchema": {
          "server": {
            "type": "string",
            "label": "서버"
          },
          "status": {
            "type": "string",
            "label": "상태"
          },
          "detail": {
            "type": "string",
            "label": "상세"
          }
        }
      },
      {
        "id": "start",
        "version": 1,
        "effect": "write",
        "scope": "host",
        "assistant": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "root": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "output": {
              "type": "string"
            }
          },
          "required": [
            "requestId",
            "root",
            "file",
            "output"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "running",
                "completed",
                "failed",
                "stopped",
                "uncertain"
              ]
            },
            "phase": {
              "type": "string"
            },
            "errorKind": {
              "type": "string"
            },
            "document": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "state",
            "phase"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "job-status",
        "version": 1,
        "effect": "read",
        "scope": "host",
        "assistant": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "root": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "output": {
              "type": "string"
            }
          },
          "required": [
            "requestId",
            "root",
            "file",
            "output"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "running",
                "completed",
                "failed",
                "stopped",
                "uncertain"
              ]
            },
            "phase": {
              "type": "string"
            },
            "errorKind": {
              "type": "string"
            },
            "document": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "state",
            "phase"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "job-stop",
        "version": 1,
        "effect": "write",
        "scope": "host",
        "assistant": false,
        "inputSchema": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "root": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "output": {
              "type": "string"
            }
          },
          "required": [
            "requestId",
            "root",
            "file",
            "output"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "running",
                "completed",
                "failed",
                "stopped",
                "uncertain"
              ]
            },
            "phase": {
              "type": "string"
            },
            "errorKind": {
              "type": "string"
            },
            "document": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string"
                }
              },
              "required": [
                "source"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "state",
            "phase"
          ],
          "additionalProperties": false
        }
      }
    ],
    "views": [
      {
        "id": "connection",
        "title": "연결 상태",
        "definition": {
          "kind": "litzio-view",
          "schemaVersion": 2,
          "catalog": "litzio-v2",
          "profile": "query",
          "owner": "community.docling",
          "title": "Docling 연결 상태",
          "refresh": "manual",
          "sources": {
            "stats": {
              "kind": "operation",
              "operation": "community.docling.connection",
              "version": 1,
              "args": {}
            }
          },
          "layout": {
            "component": "Panel",
            "direction": "vertical",
            "children": [
              {
                "component": "Table",
                "title": "docling-serve",
                "source": "stats",
                "data": "/rows",
                "columns": [
                  "server",
                  "status",
                  "detail"
                ]
              }
            ]
          }
        }
      }
    ],
    "screens": [
      {
        "id": "connection",
        "title": "Docling",
        "icon": "Table",
        "defaultViewIds": [
          "connection"
        ],
        "primary": true
      }
    ],
    "jobs": [
      {
        "id": "create-document",
        "title": "Litzio 문서 만들기",
        "accept": [
          ".docling"
        ],
        "start": "start",
        "status": "job-status",
        "stop": "job-stop",
        "resultKind": "native-document"
      }
    ]
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "serverUrl": {
        "type": "string",
        "title": "docling-serve URL",
        "description": "HTTP(S) 서버 기본 주소. 인증 정보는 API key secret에 입력하세요.",
        "default": "http://127.0.0.1:5001",
        "minLength": 1
      }
    },
    "additionalProperties": false
  },
  "secrets": [
    {
      "id": "api-key",
      "scope": "connection",
      "required": false
    }
  ]
}

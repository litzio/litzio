  "settingsSchema": {
    "type": "object",
    "properties": {
      "serverUrl": {
        "type": "string",
        "title": "Docling 서버 주소",
        "description": "HTTP(S) 서버 기본 주소. API 키가 없는 서버만 지원합니다.",
        "default": "http://127.0.0.1:5001",
        "minLength": 1
      }
    },
    "additionalProperties": false

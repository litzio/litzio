      {
        "id": "connection",
        "title": "Docling",
        "icon": "Table",
        "primary": true,
        "jobs": [
          "convert-pdf"
        ]
      }
    ],
    "jobs": [
      {
        "id": "convert-pdf",
        "title": "PDF 변환",
        "accept": [
          ".pdf"
        ],
        "start": "convert-pdf",
        "status": "job-status",
        "stop": "job-stop",
        "resultKind": "file",
        "resultExtension": ".docling"
      },
      {
        "id": "create-document",
        "title": "검수 작업공간",
        "accept": [
          ".docling"
        ],
        "start": "start",
        "status": "job-status",
        "stop": "job-stop",
        "resultKind": "native-document",
        "generatedDocument": "generated-document",
        "comparison": "compare",
        "workspace": true
      }
    ],
    "healthCheck": "connection",
    "reviews": [
      {
        "id": "compare",
        "title": "원본 대조",
        "read": {
          "operation": "community.docling.generated-document",
          "version": 1
        }
      }
    ]

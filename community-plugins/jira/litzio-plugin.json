{
  "schemaVersion": 1,
  "id": "community.jira",
  "tier": "community",
  "publisher": {
    "id": "community",
    "name": "Community"
  },
  "name": "Jira",
  "description": "내 계정 또는 지정 계정의 할당 이슈를 조회합니다.",
  "version": "0.0.2",
  "requiresSdk": ">=0.3.0 <1.0.0",
  "entry": "host.js",
  "contributes": {
    "operations": [
      {
        "id": "issues",
        "version": 2,
        "effect": "read",
        "scope": "host",
        "assistant": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "keys": {
              "type": "string",
              "title": "이슈 번호",
              "description": "선택: 입력하면 계정·상태 대신 번호로 조회 (최대 20개)",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^\\s*[A-Z][A-Z0-9_]*-[1-9][0-9]*(?:\\s*,\\s*[A-Z][A-Z0-9_]*-[1-9][0-9]*){0,19}\\s*$"
            },
            "account": {
              "type": "string",
              "title": "계정",
              "description": "선택: 비우면 PAT의 현재 사용자. 번호 입력 시 무시합니다.",
              "maxLength": 254,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            },
            "status": {
              "type": "string",
              "title": "해결 여부",
              "enum": [
                "미해결",
                "해결됨",
                "전체"
              ]
            }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "array",
          "minItems": 0,
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "assignee": {
                "type": "string"
              },
              "priority": {
                "type": "string"
              },
              "updated": {
                "type": "string"
              },
              "issueUrl": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "summary",
              "status",
              "assignee",
              "priority",
              "updated",
              "issueUrl"
            ],
            "additionalProperties": false
          }
        },
        "rowSchema": {
          "key": {
            "type": "string",
            "label": "키",
            "linkField": "issueUrl"
          },
          "summary": {
            "type": "string",
            "label": "제목"
          },
          "status": {
            "type": "string",
            "label": "상태"
          },
          "assignee": {
            "type": "string",
            "label": "담당자"
          },
          "priority": {
            "type": "string",
            "label": "우선순위"
          },
          "updated": {
            "type": "string",
            "label": "수정일"
          },
          "issueUrl": {
            "type": "string",
            "label": "이슈 페이지 URL"
          }
        }
      },
      {
        "id": "connection",
        "version": 1,
        "effect": "read",
        "scope": "host",
        "assistant": false,
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "required": [
            "ok",
            "message"
          ],
          "additionalProperties": false
        }
      }
    ],
    "views": [
      {
        "id": "issues",
        "title": "이슈 조회",
        "definition": {
          "kind": "litzio-view",
          "schemaVersion": 2,
          "catalog": "litzio-v2",
          "profile": "query",
          "owner": "community.jira",
          "title": "Jira 이슈 조회",
          "refresh": "manual",
          "sources": {
            "stats": {
              "kind": "operation",
              "operation": "community.jira.issues",
              "version": 2,
              "args": {
                "status": "미해결"
              }
            }
          },
          "layout": {
            "component": "Panel",
            "direction": "vertical",
            "children": [
              {
                "component": "Table",
                "title": "할당 이슈 · 번호 입력 시 번호 조회",
                "source": "stats",
                "data": "/rows",
                "columns": [
                  "key",
                  "summary",
                  "status",
                  "assignee",
                  "priority",
                  "updated"
                ]
              }
            ]
          },
          "form": {
            "component": "InputForm",
            "source": "stats",
            "fields": [
              {
                "component": "TextInput",
                "field": "account"
              },
              {
                "component": "Select",
                "field": "status"
              },
              {
                "component": "TextInput",
                "field": "keys"
              }
            ],
            "submit": {
              "component": "SubmitButton",
              "label": "조회"
            }
          }
        }
      }
    ],
    "screens": [
      {
        "id": "issues",
        "title": "Jira",
        "icon": "Table",
        "defaultViewIds": [
          "issues"
        ],
        "primary": true
      }
    ],
    "healthCheck": "connection"
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "baseUrl": {
        "type": "string",
        "title": "BASE_URL",
        "description": "Jira HTTP(S) 기본 주소 (context path 포함 가능)",
        "minLength": 1
      },
      "apiUrl": {
        "type": "string",
        "title": "API URL",
        "description": "선택: REST API 기본 주소. 비우면 BASE_URL/rest/api/2",
        "default": ""
      }
    },
    "required": [
      "baseUrl"
    ],
    "additionalProperties": false
  },
  "secrets": [
    {
      "id": "pat",
      "scope": "connection",
      "required": true
    }
  ]
}

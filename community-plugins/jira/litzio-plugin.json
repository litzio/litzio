{
  "schemaVersion": 1,
  "id": "community.jira",
  "tier": "community",
  "publisher": {
    "id": "community",
    "name": "Community"
  },
  "name": "Jira",
  "description": "이슈 번호로 Jira 상세를 조회합니다.",
  "version": "0.0.1",
  "requiresSdk": ">=0.1.0 <1.0.0",
  "entry": "host.js",
  "contributes": {
    "operations": [
      {
        "id": "issues",
        "version": 1,
        "effect": "read",
        "scope": "host",
        "assistant": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "keys": {
              "type": "string",
              "title": "이슈 번호",
              "description": "쉼표로 구분한 키 (최대 20개)",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^\\s*[A-Z][A-Z0-9_]*-[1-9][0-9]*(?:\\s*,\\s*[A-Z][A-Z0-9_]*-[1-9][0-9]*){0,19}\\s*$"
            }
          },
          "required": [
            "keys"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "assignee": {
                "type": "string"
              },
              "priority": {
                "type": "string"
              },
              "updated": {
                "type": "string"
              },
              "issueUrl": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "summary",
              "status",
              "assignee",
              "priority",
              "updated",
              "issueUrl"
            ],
            "additionalProperties": false
          }
        },
        "rowSchema": {
          "key": {
            "type": "string",
            "label": "키"
          },
          "summary": {
            "type": "string",
            "label": "제목"
          },
          "status": {
            "type": "string",
            "label": "상태"
          },
          "assignee": {
            "type": "string",
            "label": "담당자"
          },
          "priority": {
            "type": "string",
            "label": "우선순위"
          },
          "updated": {
            "type": "string",
            "label": "수정일"
          },
          "issueUrl": {
            "type": "string",
            "label": "이슈 페이지 URL"
          }
        }
      }
    ],
    "views": [
      {
        "id": "issues",
        "title": "이슈 조회",
        "definition": {
          "kind": "litzio-view",
          "schemaVersion": 2,
          "catalog": "litzio-v2",
          "profile": "query",
          "owner": "community.jira",
          "title": "Jira 이슈 조회",
          "refresh": "manual",
          "sources": {
            "stats": {
              "kind": "operation",
              "operation": "community.jira.issues",
              "version": 1,
              "args": {}
            }
          },
          "layout": {
            "component": "Panel",
            "direction": "vertical",
            "children": [
              {
                "component": "Table",
                "title": "이슈",
                "source": "stats",
                "data": "/rows",
                "columns": [
                  "key",
                  "summary",
                  "status",
                  "assignee",
                  "priority",
                  "updated"
                ]
              }
            ]
          },
          "form": {
            "component": "InputForm",
            "source": "stats",
            "fields": [
              {
                "component": "TextInput",
                "field": "keys"
              }
            ],
            "submit": {
              "component": "SubmitButton",
              "label": "조회"
            }
          }
        }
      }
    ],
    "screens": [
      {
        "id": "issues",
        "title": "Jira",
        "icon": "Table",
        "defaultViewIds": [
          "issues"
        ],
        "primary": true
      }
    ]
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "baseUrl": {
        "type": "string",
        "title": "BASE_URL",
        "description": "Jira HTTP(S) 기본 주소 (context path 포함 가능)",
        "minLength": 1
      },
      "apiUrl": {
        "type": "string",
        "title": "API URL",
        "description": "선택: REST API 기본 주소. 비우면 BASE_URL/rest/api/2",
        "default": ""
      }
    },
    "required": [
      "baseUrl"
    ],
    "additionalProperties": false
  },
  "secrets": [
    {
      "id": "pat",
      "scope": "connection",
      "required": true
    }
  ]
}

          },
          "dueDate": {
            "type": "string",
            "label": "기한"
          },
          "components": {
            "type": "string",
            "label": "컴포넌트"
          },
          "labels": {
            "type": "string",
            "label": "레이블"
          }
        }
      }
    ],
    "views": [
      {
        "id": "jql",
        "title": "JQL",
        "definition": {
          "kind": "litzio-view",
          "schemaVersion": 2,
          "catalog": "litzio-v2",
          "profile": "query",
          "owner": "community.jira",
          "title": "Jira JQL 검색",
          "refresh": "manual",
          "sources": {
            "stats": {
              "kind": "operation",
              "operation": "community.jira.jql",
              "version": 1,
              "args": {
                "jql": "assignee = currentUser() AND resolution = Unresolved ORDER BY updated DESC"
              }
            }
          },
          "layout": {
            "component": "Panel",
            "direction": "vertical",
            "children": [
              {
                "component": "Table",
                "title": "JQL 검색",
                "source": "stats",
                "data": "/rows",
                "columns": [
                  "key",
                  "summary",
                  "status",
                  "assignee",
                  "reporter",
                  "created",
                  "updated"
                ]
              }
            ]
          },
          "form": {
            "component": "InputForm",
            "source": "stats",
            "fields": [
              {
                "component": "TextInput",
                "field": "jql"
              }
            ],
            "submit": {
              "component": "SubmitButton",
              "label": "조회"
            }
          }
        }
      },
      {
        "id": "issues",
        "title": "간편 검색",
        "definition": {
          "kind": "litzio-view",
          "schemaVersion": 2,
          "catalog": "litzio-v2",
          "profile": "query",
          "owner": "community.jira",
          "title": "Jira 간편 검색",
          "refresh": "manual",
          "sources": {
            "stats": {
              "kind": "operation",
              "operation": "community.jira.issues",
              "version": 4,
              "args": {
                "status": "미해결",
                "dateField": "수정일"
              }
            }
          },
          "layout": {
            "component": "Panel",
            "direction": "vertical",
            "children": [
              {
                "component": "Table",
                "title": "할당 이슈 · 번호 입력 시 번호 조회",
                "source": "stats",
                "data": "/rows",
                "columns": [
                  "key",
                  "summary",
                  "status",
                  "assignee",
                  "reporter",
                  "created",
                  "updated"
                ]
              }
            ]
          },
          "form": {
            "component": "InputForm",
            "source": "stats",
            "fields": [
              {
                "component": "TextInput",
                "field": "account"
              },
              {
                "component": "Select",
                "field": "status"
              },
              {
                "component": "TextInput",
                "field": "project"
              },
              {
                "component": "TextInput",
                "field": "reporter"
              },
              {
                "component": "Select",
                "field": "dateField"
              },
              {
                "component": "TextInput",
                "field": "dateFrom"
              },
              {
                "component": "TextInput",
                "field": "dateTo"
              },
              {
                "component": "TextInput",
                "field": "keys"
              }
            ],
            "submit": {
              "component": "SubmitButton",
              "label": "조회"
            }
          }
        }
      }
    ],
    "screens": [
      {
        "id": "issues",
        "title": "Jira",
        "icon": "Table",
        "defaultViewIds": [
          "jql",
          "issues"
        ],
        "primary": true
      }
    ],
    "healthCheck": "connection"
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "baseUrl": {
        "type": "string",
        "title": "BASE_URL",
        "description": "Jira HTTP(S) 기본 주소 (context path 포함 가능)",
        "minLength": 1
      },
      "apiUrl": {
        "type": "string",
        "title": "API URL",
        "description": "선택: REST API 기본 주소. 비우면 BASE_URL/rest/api/2",
        "default": ""
      }
    },
    "required": [
      "baseUrl"
    ],
    "additionalProperties": false
  },
  "secrets": [
    {
      "id": "pat",
      "scope": "connection",
      "required": true
    }
  ],
  "icon": "icon.svg"

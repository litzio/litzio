{
  "schemaVersion": 1,
  "id": "community.jira",
  "tier": "community",
  "publisher": {
    "id": "community",
    "name": "Community"
  },
  "name": "Jira",
  "description": "내 계정 또는 지정 계정의 할당 이슈를 조회합니다.",
  "version": "0.0.4",
  "requiresSdk": ">=0.3.0 <1.0.0",
  "entry": "host.js",
  "contributes": {
    "operations": [
      {
        "id": "issues",
        "version": 4,
        "effect": "read",
        "scope": "host",
        "assistant": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "keys": {
              "type": "string",
              "title": "이슈 번호",
              "description": "선택: 번호 입력 시 다른 조건을 무시합니다. 검색 권한이 없는 이슈는 결과에서 빠질 수 있습니다. 최대 20개.",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^\\s*[A-Z][A-Z0-9_]*-[1-9][0-9]*(?:\\s*,\\s*[A-Z][A-Z0-9_]*-[1-9][0-9]*){0,19}\\s*$"
            },
            "account": {
              "type": "string",
              "title": "계정",
              "description": "선택: 비우면 PAT의 현재 사용자. 번호 입력 시 무시합니다.",
              "maxLength": 254,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            },
            "status": {
              "type": "string",
              "title": "해결 여부",
              "enum": [
                "미해결",
                "해결됨",
                "전체"
              ]
            },
            "project": {
              "type": "string",
              "title": "프로젝트 키",
              "description": "선택: 대문자 프로젝트 키. 번호 입력 시 무시합니다.",
              "maxLength": 128,
              "pattern": "^(?:[A-Z][A-Z0-9_]*)?$"
            },
            "reporter": {
              "type": "string",
              "title": "보고자",
              "description": "선택: 보고자 계정. 번호 입력 시 무시합니다.",
              "maxLength": 254,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            },
            "dateField": {
              "type": "string",
              "title": "기간 기준",
              "enum": [
                "수정일",
                "생성일"
              ]
            },
            "dateFrom": {
              "type": "string",
              "title": "시작일",
              "description": "선택: YYYY-MM-DD. 번호 입력 시 무시.",
              "maxLength": 10
            },
            "dateTo": {
              "type": "string",
              "title": "종료일",
              "description": "선택: YYYY-MM-DD, 그날 전체 포함. 번호 입력 시 무시.",
              "maxLength": 10
            }
          },
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "array",
          "minItems": 0,
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "assignee": {
                "type": "string"
              },
              "priority": {
                "type": "string"
              },
              "updated": {
                "type": "string"
              },
              "issueUrl": {
                "type": "string"
              },
              "reporter": {
                "type": "string"
              },
              "created": {
                "type": "string"
              },
              "issueType": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              },
              "dueDate": {
                "type": "string"
              },
              "components": {
                "type": "string"
              },
              "labels": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "summary",
              "status",
              "assignee",
              "priority",
              "updated",
              "issueUrl",
              "reporter",
              "created",
              "issueType",
              "resolution",
              "dueDate",
              "components",
              "labels"
            ],
            "additionalProperties": false
          }
        },
        "rowSchema": {
          "key": {
            "type": "string",
            "label": "키",
            "linkField": "issueUrl"
          },
          "summary": {
            "type": "string",
            "label": "제목"
          },
          "status": {
            "type": "string",
            "label": "상태"
          },
          "assignee": {
            "type": "string",
            "label": "담당자"
          },
          "priority": {
            "type": "string",
            "label": "우선순위"
          },
          "updated": {
            "type": "string",
            "label": "수정일"
          },
          "issueUrl": {
            "type": "string",
            "label": "이슈 페이지 URL"
          },
          "reporter": {
            "type": "string",
            "label": "보고자"
          },
          "created": {
            "type": "string",
            "label": "생성일"
          },
          "issueType": {
            "type": "string",
            "label": "유형"
          },
          "resolution": {
            "type": "string",
            "label": "해결"
          },
          "dueDate": {
            "type": "string",
            "label": "기한"
          },
          "components": {
            "type": "string",
            "label": "컴포넌트"
          },
          "labels": {
            "type": "string",
            "label": "레이블"
          }
        }
      },
      {
        "id": "connection",
        "version": 1,
        "effect": "read",
        "scope": "host",
        "assistant": false,
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "required": [
            "ok",
            "message"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "detail",
        "version": 1,
        "effect": "read",
        "scope": "host",
        "assistant": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "title": "이슈 키",
              "maxLength": 128,
              "pattern": "^[A-Z][A-Z0-9_]*-[1-9][0-9]*$"
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string"
            },
            "issueUrl": {
              "type": "string"
            },
            "fetchedAt": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "description": {
              "type": "string",
              "maxLength": 16000
            },
            "descriptionTruncated": {
              "type": "boolean"
            },
            "commentsTotal": {
              "type": "integer",
              "minimum": 0
            },
            "commentsStartAt": {
              "type": "integer",
              "minimum": 0
            },
            "commentsReturned": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "comments": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "author": {
                    "type": "string"
                  },
                  "created": {
                    "type": "string"
                  },
                  "updated": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "bodyTruncated": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "author",
                  "created",
                  "updated",
                  "body",
                  "bodyTruncated"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "key",
            "issueUrl",
            "fetchedAt",
            "summary",
            "description",
            "descriptionTruncated",
            "commentsTotal",
            "commentsStartAt",
            "commentsReturned",
            "comments"
          ],
          "additionalProperties": false
        }
      },
      {
        "id": "jql",
        "version": 1,
        "effect": "read",
        "scope": "host",
        "assistant": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "jql": {
              "type": "string",
              "title": "JQL",
              "minLength": 1,
              "maxLength": 4000,
              "description": "결과 대신 오류가 나오면 JQL 문법과 필드 이름을 확인하고, 자세한 이유는 Jira 웹의 이슈 검색에서 같은 JQL로 확인"
            }
          },
          "required": [
            "jql"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "array",
          "minItems": 0,
          "maxItems": 500,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "assignee": {
                "type": "string"
              },
              "priority": {
                "type": "string"
              },
              "updated": {
                "type": "string"
              },
              "issueUrl": {
                "type": "string"
              },
              "reporter": {
                "type": "string"
              },
              "created": {
                "type": "string"
              },
              "issueType": {
                "type": "string"
              },
              "resolution": {
                "type": "string"
              },
              "dueDate": {
                "type": "string"
              },
              "components": {
                "type": "string"
              },
              "labels": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "summary",
              "status",
              "assignee",
              "priority",
              "updated",
              "issueUrl",
              "reporter",
              "created",
              "issueType",
              "resolution",
              "dueDate",
              "components",
              "labels"
            ],
            "additionalProperties": false
          }
        },
        "rowSchema": {
          "key": {
            "type": "string",
            "label": "키",
            "linkField": "issueUrl"
          },
          "summary": {
            "type": "string",
            "label": "제목"
          },
          "status": {
            "type": "string",
            "label": "상태"
          },
          "assignee": {
            "type": "string",
            "label": "담당자"
          },
          "priority": {
            "type": "string",
            "label": "우선순위"
          },
          "updated": {
            "type": "string",
            "label": "수정일"
          },
          "issueUrl": {
            "type": "string",
            "label": "이슈 페이지 URL"
          },
          "reporter": {
            "type": "string",
            "label": "보고자"
          },
          "created": {
            "type": "string",
            "label": "생성일"
          },
          "issueType": {
            "type": "string",
            "label": "유형"
          },
          "resolution": {
            "type": "string",
